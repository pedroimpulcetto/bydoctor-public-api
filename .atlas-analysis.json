  "keyFeatures": [
    "Appointment scheduling and management API",
    "Patient records and medical history",
    "Electronic prescriptions via MEMED integration",
    "WhatsApp Business API notifications",
    "Webhook event system for real-time integrations",
    "Financial tracking — payments, health plans, bank accounts",
    "Multi-professional clinic and role-based access",
    "Teleconsultation (video) sessions",
    "Audit trail for compliance (CFM, LGPD)",
    "Patient flow Kanban board"
  ],
