    "/api/public/v1/patients": {
      "get": {
        "description": "Retorna os pacientes da clínica em ordem crescente de atualização (`updated_at` mais antigo primeiro), com paginação por cursor, e aceita `updated_since` para sincronizar, como nos agendamentos. Para não duplicar cadastros, procure por `cpf` ou `phone` (busca exata) antes de criar. Sem o filtro `active`, a lista inclui pacientes inativos. Requer o escopo `patients:read`.",
        "operationId": "patients_list",
        "parameters": [
          {
            "description": "`true` só ativos, `false` só inativos. Omitido, a lista inclui os dois.",
            "in": "query",
            "name": "active",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "CPF exato, com ou sem pontuação. Use para encontrar um paciente antes de criá-lo.",
            "in": "query",
            "name": "cpf",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Cursor de paginação retornado em `next`/`previous`.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Busca parcial pelo nome, sem diferenciar maiúsculas nem acentos.",
            "in": "query",
            "name": "name",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Resultados por página (padrão 50, máximo 100).",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Telefone exato, em qualquer formatação. Sem `+`, números de 10 ou 11 dígitos são lidos como brasileiros.",
            "in": "query",
            "name": "phone",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
