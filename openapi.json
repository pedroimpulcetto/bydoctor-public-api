{
  "components": {
    "schemas": {
      "ModalityEnum": {
        "description": "* `in_person` - Presencial\n* `telehealth` - Teleconsulta",
        "enum": [
          "in_person",
          "telehealth"
        ],
        "type": "string"
      },
      "OriginEnum": {
        "description": "* `staff` - Equipe\n* `patient_booking` - Agendamento online\n* `api` - API pública",
        "enum": [
          "staff",
          "patient_booking",
          "api"
        ],
        "type": "string"
      },
      "PaginatedPublicAppointmentList": {
        "properties": {
          "next": {
            "example": "https://api.bydoctor.com.br/api/public/v1/appointments?cursor=cD00ODY%3D",
            "format": "uri",
            "nullable": true,
            "type": "string"
          },
          "previous": {
            "example": "https://api.bydoctor.com.br/api/public/v1/appointments?cursor=cj0xJnA9NDg3",
            "format": "uri",
            "nullable": true,
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/PublicAppointment"
            },
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "type": "object"
      },
      "PatchedPublicAppointmentUpdate": {
        "description": "Corpo para alterar um agendamento. Envie apenas os campos que mudam.",
        "properties": {
          "note": {
            "description": "Observação interna do agendamento, até 2000 caracteres.",
            "maxLength": 2000,
            "type": "string"
          },
          "professional_id": {
            "description": "`professional.id` de um profissional ativo da clínica que atende pacientes.",
            "type": "integer"
          },
          "room_id": {
            "description": "`room.id` de uma sala ativa. `null` volta para a sala padrão da grade do profissional.",
            "nullable": true,
            "type": "integer"
          },
          "start_at": {
            "description": "Novo início, ISO 8601. Sem fuso horário, é lido em America/Sao_Paulo. Os segundos devem ser `00`.",
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PublicAppointmentUpdateStatusEnum"
              }
            ],
            "description": "`scheduled` ou `confirmed`. Os demais status são definidos apenas pelo aplicativo.\n\n* `scheduled` - scheduled\n* `confirmed` - confirmed"
          }
        },
        "type": "object"
      },
      "PatientSummary": {
        "description": "Paciente do agendamento.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "phone"
        ],
        "type": "object"
      },
      "ProfessionalSummary": {
        "description": "Profissional responsável pelo atendimento.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "specialty": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "specialty"
        ],
        "type": "object"
      },
      "PublicAppointment": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "end_at": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "nullable": true,
            "readOnly": true,
            "type": "string"
          },
          "modality": {
            "$ref": "#/components/schemas/ModalityEnum"
          },
          "origin": {
            "$ref": "#/components/schemas/OriginEnum"
          },
          "patient": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PatientSummary"
              }
            ],
            "nullable": true,
            "readOnly": true
          },
          "professional": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProfessionalSummary"
              }
            ],
            "nullable": true,
            "readOnly": true
          },
          "room": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RoomSummary"
              }
            ],
            "nullable": true,
            "readOnly": true
          },
          "start_at": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PublicAppointmentStatusEnum"
              }
            ],
            "description": "One of: requested, scheduled, confirmed, checked_in, completed, no_show, cancelled.",
            "readOnly": true
          },
          "updated_at": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          }
        },
        "required": [
          "created_at",
          "end_at",
          "id",
          "modality",
          "origin",
          "patient",
          "professional",
          "room",
          "start_at",
          "status",
          "updated_at"
        ],
        "type": "object"
      },
      "PublicAppointmentCreate": {
        "description": "Corpo para criar um agendamento. O agendamento nasce presencial, com\n`status: \"scheduled\"` e `origin: \"api\"`, no tipo \"Consulta\" da clínica e\ncom o pagador Particular do profissional.",
        "properties": {
          "note": {
            "description": "Observação interna do agendamento, até 2000 caracteres.",
            "maxLength": 2000,
            "type": "string"
          },
          "patient_id": {
            "description": "`patient.id` de um paciente ativo da clínica.",
            "type": "integer"
          },
          "professional_id": {
            "description": "`professional.id` de um profissional ativo da clínica que atende pacientes.",
            "type": "integer"
          },
          "room_id": {
            "description": "`room.id` de uma sala ativa. Omitido, usa a sala padrão da grade do profissional, se houver.",
            "nullable": true,
            "type": "integer"
          },
          "start_at": {
            "description": "Início do atendimento, ISO 8601. Sem fuso horário, é lido em America/Sao_Paulo. Os segundos devem ser `00`.",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "patient_id",
          "professional_id",
          "start_at"
        ],
        "type": "object"
      },
      "PublicAppointmentStatusEnum": {
        "enum": [
          "requested",
          "scheduled",
          "confirmed",
          "checked_in",
          "completed",
          "no_show",
          "cancelled"
        ],
        "type": "string"
      },
      "PublicAppointmentUpdateStatusEnum": {
        "description": "* `scheduled` - scheduled\n* `confirmed` - confirmed",
        "enum": [
          "scheduled",
          "confirmed"
        ],
        "type": "string"
      },
      "RoomSummary": {
        "description": "Sala em que o atendimento acontece, quando a clínica usa salas.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "description": "Chave de API no formato bd_live_xxxxxxxx.xxxx...",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "API REST somente leitura de agendamentos e webhooks em tempo real para integrações de clínicas.",
    "title": "ByDoctor Public API",
    "version": "v1"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/public/v1/appointments": {
      "get": {
        "description": "Retorna os agendamentos da clínica em ordem crescente de atualização (`updated_at` mais antigo primeiro), com paginação por cursor — siga `next` até o fim para obter tudo. Use `updated_since` para sincronizar apenas o que mudou desde a última consulta: agendamentos cancelados continuam aparecendo com `status: \"cancelled\"` em vez de desaparecerem da lista.",
        "operationId": "appointments_list",
        "parameters": [
          {
            "description": "Cursor de paginação retornado em `next`/`previous`.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "end_date",
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "* `in_person` - Presencial\n* `telehealth` - Teleconsulta",
            "in": "query",
            "name": "modality",
            "schema": {
              "enum": [
                "in_person",
                "telehealth"
              ],
              "type": "string"
            }
          },
          {
            "description": "Resultados por página (padrão 50, máximo 100).",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "patient_id",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "professional_id",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "room_id",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "start_date",
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "One of: requested, scheduled, confirmed, checked_in, completed, no_show, cancelled.",
            "in": "query",
            "name": "status",
            "schema": {
              "enum": [
                "cancelled",
                "checked_in",
                "completed",
                "confirmed",
                "no_show",
                "requested",
                "scheduled"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "updated_since",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedPublicAppointmentList"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Listar agendamentos",
        "tags": [
          "appointments"
        ]
      },
      "post": {
        "description": "Cria um agendamento presencial com `status: \"scheduled\"` e `origin: \"api\"`, no tipo \"Consulta\" da clínica e com o pagador Particular do profissional. Requer o escopo `appointments:write`. Envie `Idempotency-Key` para poder repetir a chamada com segurança. Responde `409` com `code` `slot_blocked` (horário bloqueado na agenda do profissional) ou `room_required` (a clínica exige sala e a grade do profissional não tem sala padrão para o horário). O corpo da resposta é o mesmo objeto de `GET`.",
        "operationId": "appointments_create",
        "parameters": [
          {
            "description": "Chave opcional (até 255 caracteres) que torna a criação idempotente: repetir a mesma requisição com a mesma chave em até 24 horas devolve o agendamento já criado, com o cabeçalho `Idempotent-Replayed: true`, em vez de criar outro. A mesma chave com um corpo diferente responde `422`.",
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicAppointmentCreate"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PublicAppointmentCreate"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PublicAppointmentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicAppointment"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Criar um agendamento",
        "tags": [
          "appointments"
        ]
      }
    },
    "/api/public/v1/appointments/{public_id}": {
      "get": {
        "description": "Retorna um único agendamento pelo seu `id` (UUID) — guarde-o como chave estrangeira do agendamento no seu sistema.",
        "operationId": "appointments_retrieve",
        "parameters": [
          {
            "in": "path",
            "name": "public_id",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-fA-F-]{36}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicAppointment"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Consultar um agendamento",
        "tags": [
          "appointments"
        ]
      },
      "patch": {
        "description": "Altera apenas os campos enviados. Só agendamentos presenciais com `status` `scheduled` ou `confirmed` podem ser alterados; a partir de `confirmed`, apenas `status` pode mudar. Requer o escopo `appointments:write`. Responde `409` com `code` `appointment_status_locked`, `appointment_finalized` (prontuário já preenchido), `appointment_cancelled`, `appointment_requested` (solicitação de paciente, resolvida no aplicativo), `modality_unsupported` (teleconsulta), `slot_blocked`, `room_required` ou `appointment_historic_conflict` (troca de profissional com prontuário já preenchido).",
        "operationId": "appointments_partial_update",
        "parameters": [
          {
            "in": "path",
            "name": "public_id",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-fA-F-]{36}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchedPublicAppointmentUpdate"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PatchedPublicAppointmentUpdate"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PatchedPublicAppointmentUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicAppointment"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Alterar um agendamento",
        "tags": [
          "appointments"
        ]
      }
    },
    "/api/public/v1/appointments/{public_id}/cancel": {
      "post": {
        "description": "Cancela o agendamento e devolve o objeto com `status: \"cancelled\"`. Idempotente: cancelar de novo responde `200` com o mesmo objeto. Requer o escopo `appointments:write`. Mesmas recusas `409` da alteração.",
        "operationId": "appointments_cancel_create",
        "parameters": [
          {
            "in": "path",
            "name": "public_id",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-fA-F-]{36}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicAppointment"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Cancelar um agendamento",
        "tags": [
          "appointments"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Produção",
      "url": "https://api.bydoctor.com.br"
    }
  ]
}
