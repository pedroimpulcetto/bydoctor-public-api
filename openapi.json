  "info": {
    "description": "API REST somente leitura de agendamentos e webhooks em tempo real para integrações de clínicas.",
    "title": "ByDoctor Public API",
    "version": "v1"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/public/v1/appointment-types": {
      "get": {
        "description": "Retorna os tipos de atendimento ativos da clínica (como \"Consulta\" e \"Retorno\"): os `id` aceitos como `appointment_type_id` em `POST /appointments`. Requer o escopo `appointments:read`.",
        "operationId": "appointment_types_list",
        "parameters": [
          {
            "description": "Cursor de paginação retornado em `next`/`previous`.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Resultados por página (padrão 50, máximo 100).",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedPublicAppointmentTypeList"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Listar tipos de atendimento",
        "tags": [
          "appointment-types"
        ]
      }
    },
    "/api/public/v1/appointment-types/{id}": {
      "get": {
        "description": "Retorna um tipo de atendimento ativo da clínica pelo `id`. Requer o escopo `appointments:read`.",
        "operationId": "appointment_types_retrieve",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "pattern": "^\\d+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicAppointmentType"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Consultar um tipo de atendimento",
        "tags": [
          "appointment-types"
        ]
      }
    },
    "/api/public/v1/appointments": {
      "get": {
        "description": "Retorna os agendamentos da clínica em ordem crescente de atualização (`updated_at` mais antigo primeiro), com paginação por cursor — siga `next` até o fim para obter tudo. Use `updated_since` para sincronizar apenas o que mudou desde a última consulta: agendamentos cancelados continuam aparecendo com `status: \"cancelled\"` em vez de desaparecerem da lista.",
        "operationId": "appointments_list",
        "parameters": [
          {
            "description": "Cursor de paginação retornado em `next`/`previous`.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "end_date",
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "* `in_person` - Presencial\n* `telehealth` - Teleconsulta",
            "in": "query",
            "name": "modality",
            "schema": {
              "enum": [
                "in_person",
                "telehealth"
              ],
              "type": "string"
            }
          },
          {
            "description": "Resultados por página (padrão 50, máximo 100).",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "patient_id",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "professional_id",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "room_id",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "start_date",
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "One of: requested, scheduled, confirmed, checked_in, completed, no_show, cancelled.",
            "in": "query",
            "name": "status",
            "schema": {
              "enum": [
                "cancelled",
                "checked_in",
                "completed",
                "confirmed",
                "no_show",
                "requested",
                "scheduled"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "updated_since",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedPublicAppointmentList"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Listar agendamentos",
        "tags": [
          "appointments"
        ]
      },
      "post": {
        "description": "Cria um agendamento presencial com `status: \"scheduled\"` e `origin: \"api\"`, no tipo de atendimento informado em `appointment_type_id` (veja `GET /appointment-types`) e com o pagador Particular do profissional; o valor vem da tabela de preços da clínica. Requer o escopo `appointments:write`. Envie `Idempotency-Key` para poder repetir a chamada com segurança. Responde `409` com `code` `slot_blocked` (horário bloqueado na agenda do profissional) ou `room_required` (a clínica exige sala e a grade do profissional não tem sala padrão para o horário). O corpo da resposta é o mesmo objeto de `GET`.",
        "operationId": "appointments_create",
        "parameters": [
          {
            "description": "Chave opcional (até 255 caracteres) que torna a criação idempotente: repetir a mesma requisição com a mesma chave em até 24 horas devolve o registro já criado, com o cabeçalho `Idempotent-Replayed: true`, em vez de criar outro. A mesma chave com um corpo diferente, ou em outro endpoint, responde `422`.",
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicAppointmentCreate"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PublicAppointmentCreate"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PublicAppointmentCreate"
              }
            }
          },
