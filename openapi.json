            "description": "Nome completo.",
            "maxLength": 255,
            "type": "string"
          },
          "phone": {
            "description": "Celular com DDD. Sem `+`, números de 10 ou 11 dígitos são lidos como brasileiros.",
            "maxLength": 40,
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "PatientSummary": {
